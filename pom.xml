<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.acme.finance</groupId>
  <artifactId>finance-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Acme Finance Platform</name>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <grpc.version>1.85.0</grpc.version>
    <protobuf.version>4.36.2</protobuf.version>
    <postgresql.version>42.7.14</postgresql.version>
    <h2.version>2.5.252</h2.version>
  </properties>
  <modules>
    <module>api/references</module>
    <module>api/accounting</module>
    <module>api/assets</module>
    <module>api/audit</module>
    <module>api/banking</module>
    <module>api/billing</module>
    <module>api/budgeting</module>
    <module>api/collections</module>
    <module>api/compliance</module>
    <module>api/contracts</module>
    <module>api/expenses</module>
    <module>api/financeportal</module>
    <module>api/insurance</module>
    <module>api/invoicing</module>
    <module>api/ledger</module>
    <module>api/lending</module>
    <module>api/payroll</module>
    <module>api/procurement</module>
    <module>api/risk</module>
    <module>api/suppliers</module>
    <module>api/treasury</module>
    <module>api/vendor-csharp</module>
    <module>api/vendor-golang</module>
    <module>api/vendor-javascript</module>
    <module>api/vendor-kotlin</module>
    <module>api/vendor-python</module>
    <module>api/vendor-rust</module>
    <module>api/vendor-swift</module>
    <module>api/vendor-typescript</module>
    <module>platform</module>
    <module>domains/accounting</module>
    <module>domains/assets</module>
    <module>domains/audit</module>
    <module>domains/banking</module>
    <module>domains/billing</module>
    <module>domains/budgeting</module>
    <module>domains/collections</module>
    <module>domains/compliance</module>
    <module>domains/contracts</module>
    <module>domains/expenses</module>
    <module>domains/financeportal</module>
    <module>domains/insurance</module>
    <module>domains/invoicing</module>
    <module>domains/ledger</module>
    <module>domains/lending</module>
    <module>domains/payroll</module>
    <module>domains/procurement</module>
    <module>domains/risk</module>
    <module>domains/suppliers</module>
    <module>domains/treasury</module>
    <module>application</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId><artifactId>grpc-bom</artifactId><version>${grpc.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId><artifactId>protobuf-bom</artifactId>
        <version>${protobuf.version}</version><type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId><artifactId>os-maven-plugin</artifactId><version>1.7.1</version>
      </extension>
    </extensions>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>21</release><parameters>true</parameters>
            <fork>true</fork><meminitial>128m</meminitial><maxmem>2048m</maxmem>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
