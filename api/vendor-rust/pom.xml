<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.finance</groupId>
    <artifactId>finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>api-vendor-rust</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>com.acme.finance</groupId>
      <artifactId>api-references</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId><artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${maven.multiModuleProjectDirectory}/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
          <useArgumentFile>true</useArgumentFile>
          <checkStaleness>true</checkStaleness>
          <attachProtoSources>false</attachProtoSources>
          <includes>
              <include>acme/authorization/v1/access_policy_query_service.proto</include>
              <include>acme/authorization/v1/access_policy_service.proto</include>
              <include>acme/authorization/v1/access_policy_validation_service.proto</include>
              <include>acme/authorization/v1/authorization.proto</include>
              <include>acme/certificates/v1/certificate_calculation_service.proto</include>
              <include>acme/certificates/v1/certificate_query_service.proto</include>
              <include>acme/certificates/v1/certificate_service.proto</include>
              <include>acme/certificates/v1/certificates.proto</include>
              <include>acme/configuration/v1/config_set_calculation_service.proto</include>
              <include>acme/configuration/v1/config_set_query_service.proto</include>
              <include>acme/configuration/v1/config_set_service.proto</include>
              <include>acme/configuration/v1/configuration.proto</include>
              <include>acme/edgegateway/v1/edgegateway.proto</include>
              <include>acme/edgegateway/v1/route_binding_query_service.proto</include>
              <include>acme/edgegateway/v1/route_binding_service.proto</include>
              <include>acme/featureflags/v1/feature_flag_query_service.proto</include>
              <include>acme/featureflags/v1/feature_flag_service.proto</include>
              <include>acme/featureflags/v1/feature_flag_validation_service.proto</include>
              <include>acme/featureflags/v1/featureflags.proto</include>
              <include>acme/keymanagement/v1/crypto_key_query_service.proto</include>
              <include>acme/keymanagement/v1/crypto_key_service.proto</include>
              <include>acme/keymanagement/v1/keymanagement.proto</include>
              <include>acme/ratelimiting/v1/rate_limit_calculation_service.proto</include>
              <include>acme/ratelimiting/v1/rate_limit_query_service.proto</include>
              <include>acme/ratelimiting/v1/rate_limit_service.proto</include>
              <include>acme/ratelimiting/v1/ratelimiting.proto</include>
              <include>acme/secrets/v1/secret_query_service.proto</include>
              <include>acme/secrets/v1/secret_service.proto</include>
              <include>acme/secrets/v1/secrets.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution><goals><goal>compile</goal><goal>compile-custom</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
