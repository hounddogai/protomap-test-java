<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.finance</groupId>
    <artifactId>finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>api-financeportal</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>com.acme.finance</groupId>
      <artifactId>api-references</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId><artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${maven.multiModuleProjectDirectory}/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
          <useArgumentFile>true</useArgumentFile>
          <checkStaleness>true</checkStaleness>
          <attachProtoSources>false</attachProtoSources>
          <includes>
              <include>acme/financeportal/v1/approval_inbox_integration_service.proto</include>
              <include>acme/financeportal/v1/approval_inbox_notification_service.proto</include>
              <include>acme/financeportal/v1/approval_inbox_query_service.proto</include>
              <include>acme/financeportal/v1/approval_inbox_service.proto</include>
              <include>acme/financeportal/v1/approval_inbox_workflow_service.proto</include>
              <include>acme/financeportal/v1/close_checklist_integration_service.proto</include>
              <include>acme/financeportal/v1/close_checklist_notification_service.proto</include>
              <include>acme/financeportal/v1/close_checklist_query_service.proto</include>
              <include>acme/financeportal/v1/close_checklist_workflow_service.proto</include>
              <include>acme/financeportal/v1/finance_workspace_gateway_service.proto</include>
              <include>acme/financeportal/v1/finance_workspace_integration_service.proto</include>
              <include>acme/financeportal/v1/finance_workspace_notification_service.proto</include>
              <include>acme/financeportal/v1/finance_workspace_query_service.proto</include>
              <include>acme/financeportal/v1/finance_workspace_service.proto</include>
              <include>acme/financeportal/v1/financeportal.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution><goals><goal>compile</goal><goal>compile-custom</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
