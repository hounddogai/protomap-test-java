<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.finance</groupId>
    <artifactId>finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>api-vendor-swift</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>com.acme.finance</groupId>
      <artifactId>api-references</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId><artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${maven.multiModuleProjectDirectory}/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
          <useArgumentFile>true</useArgumentFile>
          <checkStaleness>true</checkStaleness>
          <attachProtoSources>false</attachProtoSources>
          <includes>
              <include>acme/appointments/v1/appointment_query_service.proto</include>
              <include>acme/appointments/v1/appointment_service.proto</include>
              <include>acme/appointments/v1/appointments.proto</include>
              <include>acme/careplans/v1/care_plan_calculation_service.proto</include>
              <include>acme/careplans/v1/care_plan_query_service.proto</include>
              <include>acme/careplans/v1/care_plan_service.proto</include>
              <include>acme/careplans/v1/careplans.proto</include>
              <include>acme/patientapp/v1/patient_home_query_service.proto</include>
              <include>acme/patientapp/v1/patientapp.proto</include>
              <include>acme/patients/v1/patient_calculation_service.proto</include>
              <include>acme/patients/v1/patient_query_service.proto</include>
              <include>acme/patients/v1/patients.proto</include>
              <include>acme/prescriptions/v1/prescription_calculation_service.proto</include>
              <include>acme/prescriptions/v1/prescription_service.proto</include>
              <include>acme/prescriptions/v1/prescriptions.proto</include>
              <include>acme/telehealth/v1/telehealth.proto</include>
              <include>acme/telehealth/v1/video_visit_service.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution><goals><goal>compile</goal><goal>compile-custom</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
