<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.finance</groupId>
    <artifactId>finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>api-vendor-javascript</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>com.acme.finance</groupId>
      <artifactId>api-references</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId><artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${maven.multiModuleProjectDirectory}/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
          <useArgumentFile>true</useArgumentFile>
          <checkStaleness>true</checkStaleness>
          <attachProtoSources>false</attachProtoSources>
          <includes>
              <include>acme/admissions/v1/admission_calculation_service.proto</include>
              <include>acme/admissions/v1/admission_service.proto</include>
              <include>acme/admissions/v1/admissions.proto</include>
              <include>acme/boxoffice/v1/box_office_sale_calculation_service.proto</include>
              <include>acme/boxoffice/v1/box_office_sale_query_service.proto</include>
              <include>acme/boxoffice/v1/box_office_sale_service.proto</include>
              <include>acme/boxoffice/v1/boxoffice.proto</include>
              <include>acme/broadcasts/v1/broadcast_query_service.proto</include>
              <include>acme/broadcasts/v1/broadcast_service.proto</include>
              <include>acme/broadcasts/v1/broadcasts.proto</include>
              <include>acme/concessions/v1/concession_stand_calculation_service.proto</include>
              <include>acme/concessions/v1/concession_stand_query_service.proto</include>
              <include>acme/concessions/v1/concession_stand_service.proto</include>
              <include>acme/concessions/v1/concessions.proto</include>
              <include>acme/fanportal/v1/fan_session_query_service.proto</include>
              <include>acme/fanportal/v1/fan_session_service.proto</include>
              <include>acme/fanportal/v1/fanportal.proto</include>
              <include>acme/performers/v1/performer_service.proto</include>
              <include>acme/performers/v1/performers.proto</include>
              <include>acme/seating/v1/seat_map_calculation_service.proto</include>
              <include>acme/seating/v1/seat_map_query_service.proto</include>
              <include>acme/seating/v1/seat_map_service.proto</include>
              <include>acme/seating/v1/seating.proto</include>
              <include>acme/shows/v1/show_calculation_service.proto</include>
              <include>acme/shows/v1/show_query_service.proto</include>
              <include>acme/shows/v1/show_service.proto</include>
              <include>acme/shows/v1/shows.proto</include>
              <include>acme/sponsorships/v1/sponsor_calculation_service.proto</include>
              <include>acme/sponsorships/v1/sponsor_query_service.proto</include>
              <include>acme/sponsorships/v1/sponsor_service.proto</include>
              <include>acme/sponsorships/v1/sponsorships.proto</include>
              <include>acme/ticketing/v1/ticket_query_service.proto</include>
              <include>acme/ticketing/v1/ticket_service.proto</include>
              <include>acme/ticketing/v1/ticketing.proto</include>
              <include>acme/tours/v1/tour_query_service.proto</include>
              <include>acme/tours/v1/tour_service.proto</include>
              <include>acme/tours/v1/tours.proto</include>
              <include>acme/venues/v1/venue_query_service.proto</include>
              <include>acme/venues/v1/venue_service.proto</include>
              <include>acme/venues/v1/venue_validation_service.proto</include>
              <include>acme/venues/v1/venues.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution><goals><goal>compile</goal><goal>compile-custom</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
