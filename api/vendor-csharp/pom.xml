<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.finance</groupId>
    <artifactId>finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>api-vendor-csharp</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>com.acme.finance</groupId>
      <artifactId>api-references</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId><artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${maven.multiModuleProjectDirectory}/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
          <useArgumentFile>true</useArgumentFile>
          <checkStaleness>true</checkStaleness>
          <attachProtoSources>false</attachProtoSources>
          <includes>
              <include>acme/benefits/v1/benefit_plan_query_service.proto</include>
              <include>acme/benefits/v1/benefit_plan_service.proto</include>
              <include>acme/benefits/v1/benefits.proto</include>
              <include>acme/corporateevents/v1/corporate_event_calculation_service.proto</include>
              <include>acme/corporateevents/v1/corporate_event_service.proto</include>
              <include>acme/corporateevents/v1/corporateevents.proto</include>
              <include>acme/devices/v1/devices.proto</include>
              <include>acme/devices/v1/managed_device_calculation_service.proto</include>
              <include>acme/documents/v1/document_query_service.proto</include>
              <include>acme/documents/v1/document_service.proto</include>
              <include>acme/documents/v1/document_validation_service.proto</include>
              <include>acme/documents/v1/documents.proto</include>
              <include>acme/employeeportal/v1/employeeportal.proto</include>
              <include>acme/employeeportal/v1/portal_home_query_service.proto</include>
              <include>acme/employees/v1/employee_query_service.proto</include>
              <include>acme/employees/v1/employee_service.proto</include>
              <include>acme/employees/v1/employees.proto</include>
              <include>acme/helpdesk/v1/helpdesk.proto</include>
              <include>acme/helpdesk/v1/ticket_calculation_service.proto</include>
              <include>acme/helpdesk/v1/ticket_query_service.proto</include>
              <include>acme/helpdesk/v1/ticket_service.proto</include>
              <include>acme/itsm/v1/incident_calculation_service.proto</include>
              <include>acme/itsm/v1/incident_service.proto</include>
              <include>acme/itsm/v1/itsm.proto</include>
              <include>acme/learning/v1/course_query_service.proto</include>
              <include>acme/learning/v1/course_service.proto</include>
              <include>acme/learning/v1/learning.proto</include>
              <include>acme/licensing/v1/licensing.proto</include>
              <include>acme/licensing/v1/software_license_calculation_service.proto</include>
              <include>acme/licensing/v1/software_license_query_service.proto</include>
              <include>acme/licensing/v1/software_license_service.proto</include>
              <include>acme/onboarding/v1/onboarding.proto</include>
              <include>acme/onboarding/v1/onboarding_plan_calculation_service.proto</include>
              <include>acme/onboarding/v1/onboarding_plan_query_service.proto</include>
              <include>acme/onboarding/v1/onboarding_plan_service.proto</include>
              <include>acme/performance/v1/performance.proto</include>
              <include>acme/performance/v1/review_query_service.proto</include>
              <include>acme/performance/v1/review_service.proto</include>
              <include>acme/recruiting/v1/job_opening_calculation_service.proto</include>
              <include>acme/recruiting/v1/job_opening_query_service.proto</include>
              <include>acme/recruiting/v1/recruiting.proto</include>
              <include>acme/scheduling/v1/scheduling.proto</include>
              <include>acme/scheduling/v1/shift_query_service.proto</include>
              <include>acme/scheduling/v1/shift_service.proto</include>
              <include>acme/timekeeping/v1/timekeeping.proto</include>
              <include>acme/timekeeping/v1/timesheet_query_service.proto</include>
              <include>acme/timekeeping/v1/timesheet_service.proto</include>
              <include>acme/travel/v1/travel.proto</include>
              <include>acme/travel/v1/trip_calculation_service.proto</include>
              <include>acme/travel/v1/trip_query_service.proto</include>
              <include>acme/travel/v1/trip_service.proto</include>
              <include>acme/workplaces/v1/building_calculation_service.proto</include>
              <include>acme/workplaces/v1/building_query_service.proto</include>
              <include>acme/workplaces/v1/building_service.proto</include>
              <include>acme/workplaces/v1/workplaces.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution><goals><goal>compile</goal><goal>compile-custom</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
