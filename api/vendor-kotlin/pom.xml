<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.finance</groupId>
    <artifactId>finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>api-vendor-kotlin</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>com.acme.finance</groupId>
      <artifactId>api-references</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId><artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${maven.multiModuleProjectDirectory}/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
          <useArgumentFile>true</useArgumentFile>
          <checkStaleness>true</checkStaleness>
          <attachProtoSources>false</attachProtoSources>
          <includes>
              <include>acme/deliveries/v1/deliveries.proto</include>
              <include>acme/deliveries/v1/delivery_query_service.proto</include>
              <include>acme/deliveries/v1/delivery_service.proto</include>
              <include>acme/dispatch/v1/dispatch.proto</include>
              <include>acme/dispatch/v1/dispatch_order_query_service.proto</include>
              <include>acme/dispatch/v1/dispatch_order_service.proto</include>
              <include>acme/driverapp/v1/driver_home_query_service.proto</include>
              <include>acme/driverapp/v1/driver_home_service.proto</include>
              <include>acme/driverapp/v1/driverapp.proto</include>
              <include>acme/drivers/v1/driver_calculation_service.proto</include>
              <include>acme/drivers/v1/driver_service.proto</include>
              <include>acme/drivers/v1/drivers.proto</include>
              <include>acme/fleet/v1/fleet.proto</include>
              <include>acme/fleet/v1/vehicle_query_service.proto</include>
              <include>acme/fleet/v1/vehicle_service.proto</include>
              <include>acme/fuel/v1/fuel.proto</include>
              <include>acme/fuel/v1/fuel_card_calculation_service.proto</include>
              <include>acme/fuel/v1/fuel_card_query_service.proto</include>
              <include>acme/fuel/v1/fuel_card_service.proto</include>
              <include>acme/maintenance/v1/maintenance.proto</include>
              <include>acme/maintenance/v1/work_order_calculation_service.proto</include>
              <include>acme/maintenance/v1/work_order_query_service.proto</include>
              <include>acme/maintenance/v1/work_order_service.proto</include>
              <include>acme/routing/v1/route_calculation_service.proto</include>
              <include>acme/routing/v1/route_query_service.proto</include>
              <include>acme/routing/v1/route_service.proto</include>
              <include>acme/routing/v1/routing.proto</include>
              <include>acme/telematics/v1/telematics.proto</include>
              <include>acme/telematics/v1/telemetry_reading_calculation_service.proto</include>
              <include>acme/telematics/v1/telemetry_reading_query_service.proto</include>
              <include>acme/telematics/v1/telemetry_reading_service.proto</include>
              <include>acme/yards/v1/yard_calculation_service.proto</include>
              <include>acme/yards/v1/yard_query_service.proto</include>
              <include>acme/yards/v1/yards.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution><goals><goal>compile</goal><goal>compile-custom</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
