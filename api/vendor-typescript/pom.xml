<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.finance</groupId>
    <artifactId>finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>api-vendor-typescript</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>com.acme.finance</groupId>
      <artifactId>api-references</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId><artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${maven.multiModuleProjectDirectory}/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
          <useArgumentFile>true</useArgumentFile>
          <checkStaleness>true</checkStaleness>
          <attachProtoSources>false</attachProtoSources>
          <includes>
              <include>acme/audiences/v1/audience_query_service.proto</include>
              <include>acme/audiences/v1/audience_service.proto</include>
              <include>acme/audiences/v1/audiences.proto</include>
              <include>acme/campaigns/v1/campaigns.proto</include>
              <include>acme/campaigns/v1/marketing_campaign_query_service.proto</include>
              <include>acme/chat/v1/chat.proto</include>
              <include>acme/chat/v1/chat_room_calculation_service.proto</include>
              <include>acme/chat/v1/chat_room_service.proto</include>
              <include>acme/community/v1/community.proto</include>
              <include>acme/community/v1/forum_query_service.proto</include>
              <include>acme/community/v1/forum_service.proto</include>
              <include>acme/content/v1/article_query_service.proto</include>
              <include>acme/content/v1/article_service.proto</include>
              <include>acme/content/v1/content.proto</include>
              <include>acme/experiments/v1/experiment_calculation_service.proto</include>
              <include>acme/experiments/v1/experiment_query_service.proto</include>
              <include>acme/experiments/v1/experiments.proto</include>
              <include>acme/forms/v1/form_calculation_service.proto</include>
              <include>acme/forms/v1/form_query_service.proto</include>
              <include>acme/forms/v1/form_service.proto</include>
              <include>acme/forms/v1/forms.proto</include>
              <include>acme/localization/v1/localization.proto</include>
              <include>acme/localization/v1/translation_key_calculation_service.proto</include>
              <include>acme/localization/v1/translation_key_query_service.proto</include>
              <include>acme/localization/v1/translation_key_service.proto</include>
              <include>acme/media/v1/media.proto</include>
              <include>acme/media/v1/media_asset_calculation_service.proto</include>
              <include>acme/media/v1/media_asset_query_service.proto</include>
              <include>acme/media/v1/media_asset_service.proto</include>
              <include>acme/messaging/v1/conversation_calculation_service.proto</include>
              <include>acme/messaging/v1/conversation_query_service.proto</include>
              <include>acme/messaging/v1/conversation_service.proto</include>
              <include>acme/messaging/v1/messaging.proto</include>
              <include>acme/notifications/v1/notification_query_service.proto</include>
              <include>acme/notifications/v1/notification_service.proto</include>
              <include>acme/notifications/v1/notification_validation_service.proto</include>
              <include>acme/notifications/v1/notifications.proto</include>
              <include>acme/personalization/v1/personalization.proto</include>
              <include>acme/personalization/v1/profile_service.proto</include>
              <include>acme/surveys/v1/survey_query_service.proto</include>
              <include>acme/surveys/v1/survey_service.proto</include>
              <include>acme/surveys/v1/surveys.proto</include>
              <include>acme/webbff/v1/page_composition_query_service.proto</include>
              <include>acme/webbff/v1/page_composition_service.proto</include>
              <include>acme/webbff/v1/webbff.proto</include>
              <include>acme/webhooks/v1/webhook_endpoint_query_service.proto</include>
              <include>acme/webhooks/v1/webhook_endpoint_service.proto</include>
              <include>acme/webhooks/v1/webhooks.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution><goals><goal>compile</goal><goal>compile-custom</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
