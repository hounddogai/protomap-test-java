<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme.finance</groupId>
    <artifactId>finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>api-vendor-golang</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>com.acme.finance</groupId>
      <artifactId>api-references</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId><artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${maven.multiModuleProjectDirectory}/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
          <useArgumentFile>true</useArgumentFile>
          <checkStaleness>true</checkStaleness>
          <attachProtoSources>false</attachProtoSources>
          <includes>
              <include>acme/cart/v1/cart.proto</include>
              <include>acme/cart/v1/cart_calculation_service.proto</include>
              <include>acme/catalog/v1/catalog.proto</include>
              <include>acme/catalog/v1/product_calculation_service.proto</include>
              <include>acme/catalog/v1/product_query_service.proto</include>
              <include>acme/catalog/v1/product_service.proto</include>
              <include>acme/checkout/v1/checkout.proto</include>
              <include>acme/checkout/v1/checkout_session_service.proto</include>
              <include>acme/customers/v1/consent_record_approval_service.proto</include>
              <include>acme/customers/v1/consent_record_calculation_service.proto</include>
              <include>acme/customers/v1/consent_record_sync_service.proto</include>
              <include>acme/customers/v1/consent_record_validation_service.proto</include>
              <include>acme/customers/v1/consent_record_workflow_service.proto</include>
              <include>acme/customers/v1/customer_approval_service.proto</include>
              <include>acme/customers/v1/customer_calculation_service.proto</include>
              <include>acme/customers/v1/customer_lifecycle_service.proto</include>
              <include>acme/customers/v1/customer_query_service.proto</include>
              <include>acme/customers/v1/customer_segment_approval_service.proto</include>
              <include>acme/customers/v1/customer_segment_calculation_service.proto</include>
              <include>acme/customers/v1/customer_segment_sync_service.proto</include>
              <include>acme/customers/v1/customer_segment_validation_service.proto</include>
              <include>acme/customers/v1/customer_service.proto</include>
              <include>acme/customers/v1/customer_validation_service.proto</include>
              <include>acme/customers/v1/customer_workflow_service.proto</include>
              <include>acme/customers/v1/customers.proto</include>
              <include>acme/customers/v1/household_approval_service.proto</include>
              <include>acme/customers/v1/household_calculation_service.proto</include>
              <include>acme/customers/v1/household_query_service.proto</include>
              <include>acme/customers/v1/household_reporting_service.proto</include>
              <include>acme/customers/v1/household_validation_service.proto</include>
              <include>acme/customers/v1/household_workflow_service.proto</include>
              <include>acme/customers/v1/preference_calculation_service.proto</include>
              <include>acme/customers/v1/preference_import_service.proto</include>
              <include>acme/customers/v1/preference_reporting_service.proto</include>
              <include>acme/customers/v1/preference_sync_service.proto</include>
              <include>acme/customers/v1/preference_validation_service.proto</include>
              <include>acme/fraud/v1/fraud.proto</include>
              <include>acme/fraud/v1/risk_assessment_service.proto</include>
              <include>acme/fulfillment/v1/fulfillment.proto</include>
              <include>acme/fulfillment/v1/fulfillment_query_service.proto</include>
              <include>acme/fulfillment/v1/fulfillment_service.proto</include>
              <include>acme/giftcards/v1/gift_card_calculation_service.proto</include>
              <include>acme/giftcards/v1/gift_card_query_service.proto</include>
              <include>acme/giftcards/v1/gift_card_service.proto</include>
              <include>acme/giftcards/v1/giftcards.proto</include>
              <include>acme/identity/v1/identity.proto</include>
              <include>acme/identity/v1/user_query_service.proto</include>
              <include>acme/identity/v1/user_service.proto</include>
              <include>acme/identity/v1/user_validation_service.proto</include>
              <include>acme/loyalty/v1/loyalty.proto</include>
              <include>acme/loyalty/v1/loyalty_member_calculation_service.proto</include>
              <include>acme/loyalty/v1/loyalty_member_query_service.proto</include>
              <include>acme/merchandising/v1/collection_query_service.proto</include>
              <include>acme/merchandising/v1/merchandising.proto</include>
              <include>acme/orders/v1/order_calculation_service.proto</include>
              <include>acme/orders/v1/orders.proto</include>
              <include>acme/payments/v1/payment_calculation_service.proto</include>
              <include>acme/payments/v1/payment_query_service.proto</include>
              <include>acme/payments/v1/payments.proto</include>
              <include>acme/pricing/v1/price_list_service.proto</include>
              <include>acme/pricing/v1/pricing.proto</include>
              <include>acme/returns/v1/return_request_calculation_service.proto</include>
              <include>acme/returns/v1/return_request_service.proto</include>
              <include>acme/returns/v1/returns.proto</include>
              <include>acme/search/v1/search.proto</include>
              <include>acme/search/v1/search_index_query_service.proto</include>
              <include>acme/search/v1/search_index_service.proto</include>
              <include>acme/search/v1/search_index_validation_service.proto</include>
              <include>acme/sellers/v1/seller_query_service.proto</include>
              <include>acme/sellers/v1/seller_service.proto</include>
              <include>acme/sellers/v1/sellers.proto</include>
              <include>acme/shipping/v1/shipment_query_service.proto</include>
              <include>acme/shipping/v1/shipping.proto</include>
              <include>acme/subscriptions/v1/subscription_service.proto</include>
              <include>acme/subscriptions/v1/subscriptions.proto</include>
          </includes>
        </configuration>
        <executions>
          <execution><goals><goal>compile</goal><goal>compile-custom</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
